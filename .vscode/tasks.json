{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/aps-engine/src/main.cpp",
                "${workspaceFolder}/aps-engine/src/Scheduler.cpp",
                "-o",
                "${workspaceFolder}/aps-engine/build/debug_engine.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build C++ APS Engine independently."
        }
    ]
}