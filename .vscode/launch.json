{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug APS Engine (C++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/aps-engine/build/debug_engine.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/aps-engine",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file"
        }
    ]
}